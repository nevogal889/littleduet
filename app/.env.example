# Copy to .env and fill in. Everything is optional: with no keys the app runs in
# guest mode with mock purchases and videos served from /media on web.

# Where lesson videos, thumbnails and piano samples live in real builds.
# The app requests <VIDEO_BASE_URL>/<songId>/<classId>.mp4 and .jpg, and <VIDEO_BASE_URL>/samples/<Note>.mp3
EXPO_PUBLIC_VIDEO_BASE_URL=

# Accounts + progress sync (Supabase). Leave empty to keep accounts off.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys. Leave empty to use MockPayments.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# RevenueCat entitlement identifier that unlocks every class.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
